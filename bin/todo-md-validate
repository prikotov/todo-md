#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * todo-md validate — validate todo-md task and epic files.
 *
 * Usage:
 *   php vendor/bin/todo-md-validate [target-dir|file ...]
 *
 *   target-dir|file — project root, todo directory, or .todo.md file (default: current working directory).
 */

require_once __DIR__ . '/../src/TodoMd/Parser.php';
require_once __DIR__ . '/../src/TodoMd/Validator.php';

use TodoMd\Parser;
use TodoMd\Validator;

$targets = [];

foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--help' || $arg === '-h') {
        printHelp();
        exit(0);
    }

    if (str_starts_with($arg, '-')) {
        fwrite(STDERR, "Error: unknown option: $arg" . PHP_EOL);
        printHelp();
        exit(1);
    }

    $targets[] = $arg;
}

if ($targets === []) {
    $targets[] = getcwd() ?: '.';
}

$files = [];
foreach ($targets as $target) {
    $files = array_merge($files, Parser::findTodoFiles($target));
}

$files = array_values(array_unique($files));
sort($files);

if ($files === []) {
    echo "No .todo.md files found." . PHP_EOL;
    exit(0);
}

$errorCount  = 0;
$warningCount = 0;
$idIndex     = Parser::buildIdIndex($files);

foreach ($files as $file) {
    $result   = Validator::validateFile($file, $idIndex);
    $errors   = $result['errors'];
    $warnings = $result['warnings'];

    $errorCount  += count($errors);
    $warningCount += count($warnings);

    $relativeFile = Parser::makeRelativePath($file, getcwd() ?: '.');
    if ($errors === [] && $warnings === []) {
        echo "✓ $relativeFile" . PHP_EOL;
        continue;
    }

    echo ($errors === [] ? '!' : '✗') . " $relativeFile" . PHP_EOL;
    foreach ($errors as $error) {
        echo "  error: $error" . PHP_EOL;
    }
    foreach ($warnings as $warning) {
        echo "  warning: $warning" . PHP_EOL;
    }
}

echo PHP_EOL;
echo sprintf(
    'Validated %d file(s): %d error(s), %d warning(s).',
    count($files),
    $errorCount,
    $warningCount,
) . PHP_EOL;

if ($errorCount > 0) {
    exit(1);
}

exit(0);

function printHelp(): void
{
    echo <<<'TXT'
todo-md validate — validate todo-md task and epic files.

Usage:
  php vendor/bin/todo-md-validate [target-dir|file ...]

Options:
  --help    Show this help.

TXT;
}
