#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * todo-md-cancel — transition a task/epic to cancelled (moves to todo/cancelled/).
 *
 * Usage:
 *   php vendor/bin/todo-md-cancel <ID> [--no-backup]
 */

require_once __DIR__ . '/../src/bootstrap.php';

cliRunTransition(array_slice($argv, 1), 'cancelled', 'cancel');
