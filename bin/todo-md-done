#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * todo-md-done — transition a task/epic to done (moves to todo/done/).
 *
 * Usage:
 *   php vendor/bin/todo-md-done <ID> [--no-backup]
 */

require_once __DIR__ . '/../src/bootstrap.php';

cliRunTransition(array_slice($argv, 1), 'done', 'done');
