#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * todo-md-backlog — transition a task/epic to backlog (moves to todo/backlog/).
 *
 * Usage:
 *   php vendor/bin/todo-md-backlog <ID> [--no-backup]
 */

require_once __DIR__ . '/../src/bootstrap.php';

cliRunTransition(array_slice($argv, 1), 'backlog', 'backlog');
