{
    "name": "prikotov/todo-md",
    "description": "File-based kanban board for managing tasks in markdown files",
    "license": "MIT",
    "keywords": ["todo", "kanban", "markdown", "task-management"],
    "authors": [
        {
            "name": "Dmitry Prikotov",
            "email": "prikotov@gmail.com"
        }
    ],
    "bin": [
        "bin/todo-md-init",
        "bin/todo-md-validate",
        "bin/todo-md-export-jsonl",
        "bin/todo-md-dashboard",
        "bin/todo-md-create",
        "bin/todo-md-start",
        "bin/todo-md-review",
        "bin/todo-md-done",
        "bin/todo-md-cancel",
        "bin/todo-md-backlog",
        "bin/todo-md-set"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "archive": {
        "include": ["/bin/", "/src/"]
    }
}
